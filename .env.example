# OpenAI 兼容模型。使用 DeepSeek 时可填写：
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
# 为空时工具/摘要模型复用 LLM_MODEL。
LLM_UTILITY_MODEL=

# 高级配置：仅在未设置 SPEC_AGENT_MAX_HISTORY_TOKENS 时参与历史预算计算。
LLM_CONTEXT_WINDOW=65536

# 智能体行为配置
SPEC_AGENT_USER_ROLE=项目开发人员
SPEC_AGENT_SCENE_RULE=Idea讨论，引导用户聊天，最终生成规格定义器
SPEC_AGENT_CHAT_TEMPERATURE=0.7
SPEC_AGENT_UTILITY_TEMPERATURE=0.0
SPEC_AGENT_MAX_HISTORY_TOKENS=2500
SPEC_AGENT_CHAT_TIMEOUT_SECONDS=20
SPEC_AGENT_UTILITY_TIMEOUT_SECONDS=10
SPEC_AGENT_CHAT_MAX_RETRIES=1
SPEC_AGENT_UTILITY_MAX_RETRIES=0
SPEC_AGENT_RECURSION_LIMIT=4
SPEC_AGENT_TIMING=0

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-api-key
LANGSMITH_PROJECT=test-langgraph-agent
